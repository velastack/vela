{
	"name": "vela",
	"version": "0.10.14",
	"type": "module",
	"description": "A CLI for creating and updating SvelteKit projects",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/velastack/vela.git"
	},
	"homepage": "https://velastack.dev",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"vela": "./dist/bin.js",
		"velastack": "./dist/bin.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"build": "node --experimental-strip-types scripts/build.ts",
		"dev": "node --experimental-strip-types scripts/build.ts --watch",
		"clean": "rm -rf dist",
		"lint": "npm run lint:ts && npm run lint:format",
		"lint:ts": "tsc --noEmit",
		"lint:format": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"prepare": "npm run build"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"@faker-js/faker": "^10.6.0",
		"@velastack/patterns": "^0.2.2",
		"@velastack/pocketbase-codegen": "^0.1.0",
		"annotate-json-schema": "^0.1.0",
		"commander": "^13.1.0",
		"cross-spawn": "^7.0.6",
		"dedent": "^1.7.2",
		"dotenv": "^17.4.2",
		"fetch-cookie": "^3.2.0",
		"json-schema-faker": "^0.6.3",
		"magic-string": "^0.30.21",
		"package-manager-detector": "^1.8.0",
		"picocolors": "^1.1.1",
		"pocketbase": "^0.28.0",
		"pocketbase-server": "^0.39.11",
		"stripe": "^19.3.0",
		"svelte": "^5.56.10",
		"tinyexec": "^1.3.0",
		"ts-morph": "^28.0.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.2",
		"prettier": "^3.9.6",
		"typescript": "^5.6.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.57.1",
		"vite": "^8.0.8"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"velastack",
		"pocketbase",
		"cli",
		"starter",
		"template"
	]
}
